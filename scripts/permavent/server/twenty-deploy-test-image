#!/usr/bin/env bash
set -Eeuo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  printf '%s\n' 'ERROR: Bash 4 or later is required for this server helper.' >&2
  exit 1
fi

readonly compose_directory='/opt/twenty-test'
readonly image_repository='ghcr.io/ssypchenko/twenty'
readonly test_hostname='crm-test.permavent.co.uk'
readonly lock_file='/run/lock/twenty-deploy-test-image.lock'

usage() {
  cat <<'EOF'
Usage: sudo twenty-deploy-test-image <tag> <expected-oci-digest>

Example:
  sudo twenty-deploy-test-image \
    v2.14.3-permavent.5 \
    sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

The command pulls and verifies the published image, updates the Test TAG, and
recreates only the Test server and worker services.
EOF
}

fail() {
  printf 'ERROR: %s\n' "$1" >&2
  exit 1
}

require_compose_services() {
  local required_service
  local configured_service
  local found
  local -a configured_services=()

  mapfile -t configured_services < <(docker compose config --services)

  for required_service in "$@"; do
    found='false'
    for configured_service in "${configured_services[@]}"; do
      if [[ "$configured_service" == "$required_service" ]]; then
        found='true'
        break
      fi
    done
    [[ "$found" == 'true' ]] ||
      fail "Required Compose service is missing: ${required_service}"
  done
}

if [[ "${EUID}" -ne 0 ]]; then
  fail 'This command must be run as root through sudo.'
fi

if [[ "${1:-}" == '--help' || "${1:-}" == '-h' ]]; then
  usage
  exit 0
fi

[[ "$#" -eq 2 ]] || {
  usage >&2
  exit 2
}

readonly tag="$1"
readonly expected_digest="$2"

[[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-permavent\.[0-9]+$ ]] ||
  fail "Invalid Permavent image tag: ${tag}"
[[ "$expected_digest" =~ ^sha256:[0-9a-f]{64}$ ]] ||
  fail 'The expected OCI digest must use the sha256:<64 lowercase hex characters> format.'

for command_name in docker curl flock grep sed sha256sum; do
  command -v "$command_name" >/dev/null 2>&1 ||
    fail "Required command is unavailable: ${command_name}"
done

exec 9>"$lock_file"
flock -n 9 || fail 'Another Test image deployment is already running.'

cd "$compose_directory"
[[ -f .env ]] || fail "Missing ${compose_directory}/.env"
[[ -f docker-compose.yml ]] || fail "Missing ${compose_directory}/docker-compose.yml"

install -d -m 700 backups

readonly timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
readonly image="${image_repository}:${tag}"
readonly expected_repo_digest="${image_repository}@${expected_digest}"
readonly deployment_log="${compose_directory}/backups/test-image-deploy-${tag}-${timestamp}.log"
readonly status_file="${compose_directory}/backups/test-image-deploy-${tag}-${timestamp}.status"
readonly service_log="${compose_directory}/backups/test-image-services-${tag}-${timestamp}.log"
next_env="${compose_directory}/.env.next-${timestamp}"

finish() {
  local exit_code=$?

  trap - EXIT
  [[ ! -e "$next_env" ]] || rm -f "$next_env"
  printf '%s\n' "$exit_code" > "$status_file"
  printf 'Deployment exit status: %s\n' "$exit_code"
  printf 'Deployment log: %s\n' "$deployment_log"
  printf 'Status file: %s\n' "$status_file"
  exit "$exit_code"
}
trap finish EXIT

exec > >(tee -a "$deployment_log") 2>&1

printf 'Starting Test image deployment at %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
printf 'Image: %s\n' "$image"
printf 'Expected OCI digest: %s\n' "$expected_digest"

mapfile -t configured_tags < <(grep -E '^TAG=' .env)
[[ "${#configured_tags[@]}" -eq 1 ]] ||
  fail 'The Test .env file must contain exactly one TAG entry.'
readonly current_tag="${configured_tags[0]#TAG=}"
[[ "$current_tag" != "$tag" ]] ||
  fail "Test is already configured for ${tag}; no deployment was performed."

require_compose_services db redis server worker
docker compose config --quiet

readonly db_container_before="$(docker compose ps -q db)"
readonly redis_container_before="$(docker compose ps -q redis)"
[[ -n "$db_container_before" ]] || fail 'The Test database container is unavailable.'
[[ -n "$redis_container_before" ]] || fail 'The Test Redis container is unavailable.'

printf 'Pulling %s\n' "$image"
docker pull "$image"

readonly repo_digests="$(docker image inspect "$image" --format '{{range .RepoDigests}}{{println .}}{{end}}')"
grep -Fxq "$expected_repo_digest" <<< "$repo_digests" ||
  fail "Pulled image does not match the expected OCI digest: ${expected_digest}"

readonly architecture="$(docker image inspect "$image" --format '{{.Architecture}}')"
readonly operating_system="$(docker image inspect "$image" --format '{{.Os}}')"
readonly upstream_version="${tag%%-permavent.*}"
readonly image_environment="$(docker image inspect "$image" --format '{{range .Config.Env}}{{println .}}{{end}}')"
[[ "$architecture" == 'amd64' ]] || fail "Expected amd64; found ${architecture}."
[[ "$operating_system" == 'linux' ]] || fail "Expected linux; found ${operating_system}."
grep -Fxq "APP_VERSION=${upstream_version}" <<< "$image_environment" ||
  fail "The image does not declare APP_VERSION=${upstream_version}."
printf 'Published image metadata and digest verified.\n'

readonly env_backup="${compose_directory}/backups/.env.before-${tag}-${timestamp}"
cp --preserve=mode,ownership,timestamps .env "$env_backup"
cp --preserve=mode,ownership,timestamps .env "$next_env"
sed -i "s/^TAG=.*/TAG=${tag}/" "$next_env"
grep -Fxq "TAG=${tag}" "$next_env" || fail 'The staged TAG update failed.'
docker compose --env-file "$next_env" config --quiet
mv "$next_env" .env

readonly deployment_started_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

printf 'Recreating Test server.\n'
docker compose up -d --no-deps --force-recreate server
readonly server_container="$(docker compose ps -q server)"
[[ -n "$server_container" ]] || fail 'The recreated Test server container is unavailable.'

for _ in $(seq 1 60); do
  server_health="$(docker inspect "$server_container" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')"
  [[ "$server_health" != 'healthy' ]] || break
  [[ "$server_health" != 'unhealthy' && "$server_health" != 'exited' && "$server_health" != 'dead' ]] ||
    fail "Test server entered state: ${server_health}"
  sleep 5
done

server_health="$(docker inspect "$server_container" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}')"
[[ "$server_health" == 'healthy' ]] ||
  fail 'Test server did not become healthy within five minutes.'

printf 'Recreating Test worker.\n'
docker compose up -d --no-deps --force-recreate worker
sleep 10
readonly worker_container="$(docker compose ps -q worker)"
[[ -n "$worker_container" ]] || fail 'The recreated Test worker container is unavailable.'
[[ "$(docker inspect "$worker_container" --format '{{.State.Status}}')" == 'running' ]] ||
  fail 'Test worker is not running.'

readonly expected_image_id="$(docker image inspect "$image" --format '{{.Id}}')"
[[ "$(docker inspect "$server_container" --format '{{.Image}}')" == "$expected_image_id" ]] ||
  fail 'Test server is not using the expected image ID.'
[[ "$(docker inspect "$worker_container" --format '{{.Image}}')" == "$expected_image_id" ]] ||
  fail 'Test worker is not using the expected image ID.'
[[ "$(docker inspect "$server_container" --format '{{.RestartCount}}')" == '0' ]] ||
  fail 'Test server has restarted during deployment verification.'
[[ "$(docker inspect "$worker_container" --format '{{.RestartCount}}')" == '0' ]] ||
  fail 'Test worker has restarted during deployment verification.'
[[ "$(docker compose ps -q db)" == "$db_container_before" ]] ||
  fail 'The Test database container changed during deployment.'
[[ "$(docker compose ps -q redis)" == "$redis_container_before" ]] ||
  fail 'The Test Redis container changed during deployment.'

curl --fail --silent --show-error http://127.0.0.1:3002/healthz >/dev/null
curl --fail --silent --show-error \
  --resolve "${test_hostname}:443:127.0.0.1" \
  "https://${test_hostname}/healthz" >/dev/null
curl --fail --silent --show-error \
  --resolve "${test_hostname}:443:127.0.0.1" \
  "https://${test_hostname}/" >/dev/null

docker compose logs --no-color --since "$deployment_started_at" server worker > "$service_log"
if sed -E 's/\x1B\[[0-9;]*[mK]//g' "$service_log" |
  grep -Ein '(^|[[:space:]])(ERROR|FATAL)([[:space:]]|$)|UnhandledPromiseRejection|TypeError:|ReferenceError:|QueryFailedError'; then
  fail "Error diagnostics were found in ${service_log}."
fi

printf 'Configuration checksums:\n'
sha256sum .env docker-compose.yml
printf 'Service state:\n'
docker compose ps
printf 'Audit copy: %s\n' "$env_backup"
printf 'Service log: %s\n' "$service_log"
printf 'Test image deployment completed successfully.\n'
