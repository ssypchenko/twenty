#!/usr/bin/env bash
set -Eeuo pipefail

readonly compose_directory='/opt/twenty-test'
readonly db_container='twenty-test-db-1'
readonly repair_sql='/usr/local/share/twenty/permavent/twenty-repair-v2-18-upgrade-order.sql'
readonly health_url='http://127.0.0.1:3002/healthz'
readonly lock_file='/run/lock/twenty-deploy-test-image.lock'

usage() {
  cat <<'EOF'
Usage: sudo twenty-repair-test-v2-18-upgrade-order

The command backs up the Test database, repairs the legacy Permavent v2.15
upgrade ordering markers, and restarts Test so the v2.18 upgrade can resume.
EOF
}

fail() {
  printf 'ERROR: %s\n' "$1" >&2
  return 1
}

[[ "${EUID}" -eq 0 ]] || fail 'Run this command through sudo.'
if [[ "${1:-}" == '--help' || "${1:-}" == '-h' ]]; then
  usage
  exit 0
fi
[[ "$#" -eq 0 ]] || fail 'This command does not accept arguments.'

for command_name in curl docker flock sha256sum; do
  command -v "$command_name" >/dev/null 2>&1 ||
    fail "Required command is unavailable: ${command_name}"
done
[[ -r "$repair_sql" ]] || fail "Missing repair SQL: ${repair_sql}"

exec 9>"$lock_file"
flock -n 9 || fail 'Another Test backup or deployment is already running.'

cd "$compose_directory"
docker compose config --quiet

umask 077
readonly timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
readonly run_directory="${compose_directory}/backups/test-v2-18-order-repair-${timestamp}"
readonly database_backup="${run_directory}/database-before-repair.dump"
readonly operation_log="${run_directory}/repair.log"
readonly service_log="${run_directory}/services.log"
readonly status_file="${run_directory}/repair.status"

install -d -m 700 "$run_directory"
exec > >(tee -a "$operation_log") 2>&1

finish() {
  local exit_code=$?
  trap - EXIT
  printf '%s\n' "$exit_code" > "$status_file"
  printf 'Repair exit status: %s\n' "$exit_code"
  printf 'Repair log: %s\n' "$operation_log"
  printf 'Status file: %s\n' "$status_file"
  exit "$exit_code"
}
trap finish EXIT

wait_for_health() {
  for _ in $(seq 1 90); do
    if curl --fail --silent --show-error "$health_url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  fail 'Timed out waiting for the Test health check.'
}

restart_test_on_error() {
  local exit_code=$?
  trap - ERR
  set +e
  docker compose up -d
  wait_for_health
  exit "$exit_code"
}
trap restart_test_on_error ERR

printf 'Starting Test v2.18 upgrade-order repair at %s.\n' \
  "$(date -u '+%Y-%m-%d %H:%M:%S UTC')"

docker compose up -d db redis
docker compose stop server worker

docker exec "$db_container" sh -lc \
  'pg_dump -h localhost -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' \
  > "${database_backup}.partial"
mv "${database_backup}.partial" "$database_backup"
chmod 600 "$database_backup"
docker exec -i "$db_container" pg_restore -l < "$database_backup" >/dev/null

docker exec -i "$db_container" sh -lc \
  'psql -v ON_ERROR_STOP=1 -h localhost -U "$POSTGRES_USER" -d "$POSTGRES_DB"' \
  < "$repair_sql"

readonly restart_started_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
docker compose up -d server
wait_for_health
docker compose up -d worker
sleep 10

docker compose logs --no-color --since "$restart_started_at" server worker > "$service_log"
if sed -E 's/\x1B\[[0-9;]*[mK]//g' "$service_log" |
  grep -Ein '(^|[[:space:]])(ERROR|FATAL)([[:space:]]|$)|UnhandledPromiseRejection|QueryFailedError'; then
  fail "Error diagnostics were found in ${service_log}."
fi

trap - ERR
printf 'Test v2.18 upgrade-order repair completed successfully.\n'
sha256sum "$database_backup" "$repair_sql"
docker compose ps
